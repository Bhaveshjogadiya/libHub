
PORT=5000
CLIENT_URL=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/libhub
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
NODE_ENV=development
UPLOAD_DIR=uploads

# Optional MySQL subsystem: support/contact inbox (separate from MongoDB library records)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=libhub_app
MYSQL_PASSWORD=replace-with-a-local-password
MYSQL_DATABASE=libhub_support
